{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am"],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "All non-major updates in one PR, merged by Renovate once CI is green. Exempt from the PR limits, so pending majors never block it.",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "non-major",
      "automerge": true,
      "prConcurrentLimit": 0,
      "prHourlyLimit": 0
    },
    {
      "description": "Keep after non-major. A PHP minor or major bump is a project decision: its own PR, opened on demand from the dashboard.",
      "matchPackageNames": ["php"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "php",
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
